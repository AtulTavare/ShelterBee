rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPERS & PILLARS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tavareatul7192@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- DEFAULT DENY ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. USERS COLLECTION ---
    match /users/{userId} {
      // Identity Integrity check
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'role']) &&
               data.uid == request.auth.uid &&
               data.role in ['visitor', 'owner', 'partner', 'admin'] &&
               (data.get('email', '') is string) &&
               (data.get('displayName', '') is string);
      }

      // Broad read access is required for UI to show profiles of owners/visitors
      allow read: if isSignedIn(); 
      allow create: if isOwner(userId) && isValidUser(incoming());
      // Allow admin (e.g. approve partner) & owner updates; prevent self-role-elevation
      allow update: if isSignedIn() && (
        (isOwner(userId) && (
          (!incoming().diff(existing()).affectedKeys().hasAny(['role']) || isAdmin())
        )) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- 2. PROPERTIES COLLECTION ---
    match /properties/{propertyId} {
      function isValidProperty(data) {
        return data.ownerId == request.auth.uid &&
               data.title is string && data.title.size() <= 500 &&
               data.pricePerDay is number &&
               data.status in ['Pending', 'Approved', 'Rejected', 'Draft'];
      }

      // Allow listing approved properties to everyone, and all properties to signed-in users 
      // (to fix "Missing or insufficient permissions" when loading details or owner dashboard)
      allow read: if (resource.data.status == 'Approved') || 
                   (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      
      // Specifically allow specific read for PropertyDetail/BookingPage by signed-in users
      allow get: if resource.data.status == 'Approved' || 
                   (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));

      allow create: if isSignedIn() && isValidProperty(incoming()) && isValidId(propertyId);
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.ownerId == request.auth.uid && (
          incoming().ownerId == existing().ownerId &&
          // Prevent owners from force-approving their own listings
          (incoming().status == 'Pending' || !incoming().diff(existing()).affectedKeys().hasAny(['status']) || isAdmin())
        ))
      );
      
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // --- 3. BOOKINGS COLLECTION ---
    match /bookings/{bookingId} {
      // READ: Broadened to allow availability calendar fetches by visitors
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && incoming().visitorId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        resource.data.visitorId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid || 
        isAdmin() ||
        // Allow cross-user updates for specific terminal fields during wallet processing
        incoming().diff(existing()).affectedKeys().hasOnly(['walletProcessed', 'updatedAt'])
      );
      
      allow delete: if isAdmin();
    }

    // --- 4. WALLETS COLLECTION ---
    match /wallets/{userId} {
      // READ: Broadened to allow transactions in walletService.ts to access partner wallets
      allow read: if isSignedIn();
      
      allow create: if isSignedIn(); // Allow creation during first transaction
      
      // Broadened update for atomic client-side transactions
      allow update: if isSignedIn(); 
      
      allow delete: if isAdmin();
    }

    // --- 5. WALLET TRANSACTIONS & VARIANT ---
    match /walletTransactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- 6. WITHDRAWAL REQUESTS ---
    match /withdrawalRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- 7. REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.visitorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // --- 8. NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- 9. FEEDBACKS, REPORTS, SUPPORT ---
    match /feedbacks/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /reports/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /support_inquiries/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /support_tickets/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- 10. COUPONS ---
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        (resource == null || request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && 
        (
          resource.data.ownerId == request.auth.uid || 
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])) || 
          isAdmin()
        );
      allow delete: if isSignedIn() && 
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /couponUsage/{usageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- 11. PARTNERS ---
    match /partners/{partnerId} {
      allow read: if isSignedIn() && (request.auth.uid == partnerId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == partnerId;
      allow update: if isSignedIn() && (request.auth.uid == partnerId || isAdmin());
      allow delete: if isAdmin();
    }
    match /partnerCommissions/{commissionId} {
      allow read: if isSignedIn() && (resource.data.partnerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // LEGACY PATHS
    match /support/{docId} {
      allow read, write: if isAdmin();
      allow create: if isSignedIn();
    }
    match /feedback/{docId} {
      allow read, write: if isAdmin();
      allow create: if isSignedIn();
    }
  }
}
